JWT_ACCESS_SECRET=your_access_secret_here
JWT_REFRESH_SECRET=your_refresh_secret_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

MONGO_URI=mongodb://localhost:27017/malikse
# OR: mongodb+srv://<user>:<pass>@cluster.mongodb.net/malikse

PORT=5000
NODE_ENV=development

# Required HTTPS origins in production. Comma-separated, without trailing slashes.
PUBLIC_API_URL=
CORS_ORIGINS=
# Only trusted reverse proxy IPs/CIDRs (or Express named ranges); never use '*'.
# Leave empty when the API is accessed directly.
TRUSTED_PROXIES=
# JSON request logs default on in production; omit bodies, tokens and query strings.
REQUEST_LOGS=
MONGO_MAX_POOL_SIZE=50
MONGO_MIN_POOL_SIZE=0
MONGO_MAX_CONNECTING=2
MONGO_WAIT_QUEUE_TIMEOUT_MS=2000

# One API process with all visibility writes through its shared Mongoose models.
# Production response caching requires this explicit single-writer contract.
# External imports/admin scripts require maintenance mode and an API restart.
PUBLIC_CACHE_SINGLE_WRITER=false
PUBLIC_RESPONSE_CACHE_ENABLED=true
PUBLIC_JSON_COMPRESSION=true
# Optional external Redis, e.g. rediss://... (never commit credentials).
# Without Redis, the bounded 32 MiB local response cache remains available.
REDIS_URL=
PUBLIC_READ_CONCURRENCY=16
PUBLIC_READ_QUEUE=32
PUBLIC_READ_QUEUE_MS=100
# Requests per source IP per minute, separate buckets for each auth endpoint.
# Memory store is per instance; use a shared store before scaling replicas.
AUTH_LOGIN_LIMIT=20
AUTH_REGISTER_LIMIT=10
AUTH_REFRESH_LIMIT=60

# The API processes durable listing submissions by default. Disable only when
# running a separate `npm run worker:submissions` process against the same DB.
SUBMISSION_WORKER_ENABLED=true

# Required only when running npm run seed:admin
ADMIN_NAME=
ADMIN_MOBILE=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Current limits are enforced in code: documents 20 MB in server/uploads;
# property photos 10 MB, stored in GridFS with legacy local-file fallback.
# UPLOAD_DIR and MAX_FILE_SIZE_MB are not runtime configuration options.

# Optional: S3-compatible storage
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_ENDPOINT=
