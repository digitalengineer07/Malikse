{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules", "dist",
    "src/scripts/seed*.ts",
    "src/scripts/importProperty*.ts",
    "src/scripts/uploadProperty*.ts",
    "src/scripts/updatePropertyImages.ts",
    "src/scripts/updateTypes.ts",
    "src/scripts/setupStaffAndAssignments.ts",
    "src/scripts/verifyStaff.ts"
  ]
}
