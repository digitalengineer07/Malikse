{
  "cli": {
    "version": ">= 7.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "environment": "preview",
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease -PreactNativeArchitectures=arm64-v8a"
      },
      "env": {
        "EXPO_PUBLIC_GOOGLE_CLIENT_ID": "1098456944107-0uthc86tghi4o2c80o9c6ejuiv1chpd2.apps.googleusercontent.com",
        "EXPO_PUBLIC_API_BASE_URL": "https://malikseserver.devoxa.in"
      }
    },
    "production": {
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://malikseserver.devoxa.in"
      },
      "android": {
        "buildType": "app-bundle"
      }
    },
    "preview-arm32": {
      "extends": "preview",
      "android": {
        "gradleCommand": ":app:assembleRelease -PreactNativeArchitectures=armeabi-v7a"
      }
    },
    "preview-emulator": {
      "extends": "preview",
      "android": {
        "gradleCommand": ":app:assembleRelease -PreactNativeArchitectures=x86_64"
      }
    }
  }
}
