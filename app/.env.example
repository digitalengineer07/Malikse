# Copy this file to .env and fill in your values.
# This file SHOULD be committed. .env should NOT.


# Google OAuth Client ID (from Google Cloud Console > Credentials)
# Required for Google Sign-In
EXPO_PUBLIC_GOOGLE_CLIENT_ID=

# Maps SDK for Android. Restrict the key to the Android package and signing SHA-1.
# Set the real value in EAS environment variables or an ignored .env.local file.
GOOGLE_MAPS_ANDROID_API_KEY=


# Optional Maps JavaScript/Places client key. Use a separate, restricted key.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Backend API base URL
EXPO_PUBLIC_API_BASE_URL=http://localhost:5000
EXPO_PUBLIC_WEBSITE_URL=https://malikse.com
