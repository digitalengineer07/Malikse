{
  "expo": {
    "name": "MalikSe App",
    "slug": "malikse-app",
    "owner": "nikhilkr0035",
    "version": "3.1.1",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "malikse",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.devoxa.malikse",
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "largeIcon": "./assets/images/notification-badge.png",
          "color": "#FCC61C",
          "defaultChannel": "updates"
        }
      ],
      "./plugins/withSmallAndroidBuild"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "c144cce3-b103-4049-9e6c-db24224e1302"
      }
    }
  }
}
